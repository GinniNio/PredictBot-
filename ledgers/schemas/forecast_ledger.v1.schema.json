{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "forecast_ledger.v1",
  "title": "PredictBot forecast ledger -- one JSON object per line (JSONL), append-only",
  "description": "Every line is ONE EVENT for exactly one forecast_id. A forecast's current state is the merge of every event recorded for its forecast_id, in file order -- never a single mutated record. Every forecast generated is recorded here, including those never placed as a ticket (selection_status starts at 'considered' and only reaches 'placed' via a SELECTION_UPDATED event cross-referenced from betting_ledger.v1's PLACED event legs).",
  "schema_version": "1.0.0",
  "type": "object",
  "required": ["schema_version", "event_type", "forecast_id", "recorded_at_utc", "payload"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0.0"},
    "event_type": {"type": "string", "enum": ["RECORDED", "SELECTION_UPDATED", "SCORED"]},
    "forecast_id": {"type": "string", "pattern": "^fc_[0-9a-f]{16}$"},
    "recorded_at_utc": {"type": "string", "format": "date-time"},
    "payload": {"type": "object"}
  },
  "event_payloads": {
    "RECORDED": {
      "required": [
        "created_at_utc", "fixture_id", "sport", "league", "kickoff_utc",
        "market_type", "offered_odds", "model_probabilities", "model_version",
        "artifact_hash", "input_hash", "output_hash", "classification"
      ],
      "properties": {
        "created_at_utc": {"type": "string", "format": "date-time"},
        "fixture_id": {"type": "string"},
        "sport": {"type": "string"},
        "league": {"type": "string"},
        "kickoff_utc": {"type": "string", "format": "date-time"},
        "market_type": {"type": "string"},
        "offered_odds": {
          "type": "object",
          "required": ["H", "D", "A"],
          "properties": {"H": {"type": "number"}, "D": {"type": "number"}, "A": {"type": "number"}}
        },
        "model_probabilities": {
          "type": "object",
          "required": ["H", "D", "A"],
          "properties": {"H": {"type": "number"}, "D": {"type": "number"}, "A": {"type": "number"}}
        },
        "model_version": {"type": "string"},
        "artifact_hash": {"type": "string"},
        "input_hash": {"type": "string"},
        "output_hash": {"type": "string"},
        "classification": {"type": "string"},
        "selection_status": {"type": "string", "enum": ["considered", "shortlisted", "placed", "skipped"], "default": "considered"},
        "market_probabilities": {"type": ["object", "null"]},
        "batch_id": {"type": ["string", "null"]},
        "capture_id": {"type": ["string", "null"]},
        "source": {"type": ["string", "null"]},
        "captured_at_utc": {"type": ["string", "null"]},
        "selection": {"type": ["string", "null"]},
        "stop_reason": {"type": ["string", "null"]},
        "operator_decision": {"type": ["string", "null"]}
      }
    },
    "SELECTION_UPDATED": {
      "required": ["selection_status"],
      "properties": {
        "selection_status": {"type": "string", "enum": ["considered", "shortlisted", "placed", "skipped"]},
        "note": {"type": "string"},
        "operator_decision": {"type": ["string", "null"]}
      }
    },
    "SCORED": {
      "required": ["actual_result", "brier_score", "log_loss", "settled_at_utc"],
      "properties": {
        "actual_result": {"type": "string", "enum": ["H", "D", "A"]},
        "brier_score": {"type": "number"},
        "log_loss": {"type": "number"},
        "closing_odds": {
          "type": ["object", "null"],
          "properties": {"H": {"type": "number"}, "D": {"type": "number"}, "A": {"type": "number"}}
        },
        "market_comparison": {"type": ["object", "null"]},
        "settled_at_utc": {"type": "string", "format": "date-time"}
      }
    }
  }
}
