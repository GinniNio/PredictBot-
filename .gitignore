__pycache__/
*.pyc
build/
dist/
*.egg-info/
.venv/

# data_pipeline: raw Football-Data downloads are large, third-party, and
# not ours to redistribute — only the retrieval-log METADATA
# (data_pipeline/retrieval_log.json: sha256/timestamp/URL per file) and the
# generated reports are committed. Never commit the CSV content itself.
data_pipeline/raw/

# data_pipeline/dataset_builder.py's produced dataset files (one per split,
# under data_pipeline/dataset/) reshape the same third-party Football-Data
# row content (team names, dates, odds) covered by the data_pipeline/raw/
# rule above — never ours to redistribute either, even reshaped/filtered.
# Only the small evidence/report files it writes to data_pipeline/reports/
# (row counts, hashes, the sanitized rejected-row sample) are committed.
data_pipeline/dataset/

# ledgers/: real forecast/betting ledger DATA (created by `python -m
# ledgers.cli init`) never belongs in git -- it is personal betting/
# financial history, not a repository artifact. The repository ships only
# schemas, examples, and tooling (ledgers/*.py, ledgers/schemas/,
# ledgers/examples/). The CLI's own default directory:
ledger_data/
# Any real ledger file, wherever an operator points --dir (the default
# above is the common case, but this rule holds regardless of directory
# name/location) -- a repository-committed example lives only under
# ledgers/examples/*.json (never *.jsonl), so this blanket rule never
# hides anything meant to be tracked.
*.jsonl
# Regenerated CSV views (ledgers.cli export-csv, default output
# location) -- always a derived export of the JSONL ledgers above, never
# hand-edited, never the source of truth, and never itself a repository
# artifact (already covered by the ledger_data/ rule above; named
# explicitly here for clarity). A blanket *.csv rule is deliberately NOT
# used -- this repository already commits real CSV fixtures under
# tests/fixtures/football_data/, which must stay tracked.
ledger_data/csv/

# browser_extension/bet9ja_capture/: standard Node dev-dependency install
# output (jsdom, for the test suite only -- the extension itself ships zero
# runtime dependencies). Never committed, regenerated by `npm install`.
browser_extension/*/node_modules/
